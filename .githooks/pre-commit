#!/usr/bin/env bash
# Refuses a commit that stages a project capture inside a skill directory: any path under
# skills/<skill>/**/local/ or skills/<skill>/**/capture/. A skill's directory is symlinked into
# ~/.claude and shared by every project that installs it, and this repo is public, so a capture
# (a filled map, a scan report, a note quoting real paths) can only live in the project it came
# from; see README. Enable once per clone: git config core.hooksPath .githooks
set -uo pipefail
staged="$(git diff --cached --name-only --diff-filter=ACR | grep -E '^skills/[^/]+/(.*/)?(local|capture)/' || true)"
[ -z "$staged" ] && exit 0
{
  echo "pre-commit: a project capture is staged inside a skill directory. It belongs to the project it came from; delete it here:"
  sed 's/^/  /' <<<"$staged"
} >&2
exit 1
